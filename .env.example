NEXT_PUBLIC_SESSION_ENCRYPTION_KEY=change-this-session-key
SESSION_ENCRYPTION_KEY=change-this-backend-session-key
AUTH_SESSION_SECRET=change-this-auth-session-secret
FRONTEND_URL=http://localhost:3000
# DB config (gunakan kredensial PostgreSQL yang sama dengan backend sebelumnya)
# Alternatif cepat: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=toefl_ielts_db

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional folder for profile uploads
# CLOUDINARY_UPLOAD_FOLDER=wikin/profiles

CUSTOM_API_KEY=your_openai_api_key_here
CUSTOM_API_ENDPOINT=https://your-gateway.com/v1
CUSTOM_MODEL_NAME=model_name
CUSTOM_MODEL_SUPPORTS_STRUCTURED_OUTPUT=true
# Optional cookie tuning for deployment:
# AUTH_COOKIE_SAMESITE=None
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.yourdomain.com
# For OAuth state cookie in callback/login flow:
# AUTH_COOKIE_SECURE=true
NODE_ENV=development
ADMIN_EMAILS=email@gmail.com,email2@gmail.com
NEXT_PUBLIC_MAINTENANCE_MODE=OFF